# Copy to a PRIVATE file (e.g. /etc/xianyu-monitor/monitor.env, mode 0640) and fill in.
# Never commit the filled-in copy. All values below are placeholders.

XVM_ENV=production
# MySQL 8 (utf8mb4). Create the database/user with deploy/mysql-init.sql.
XVM_DATABASE_URL=mysql+aiomysql://xvm:CHANGE_ME_DB_PASSWORD@127.0.0.1:3306/xianyu_monitor?charset=utf8mb4
# 32+ random characters: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
XVM_SECRET_KEY=CHANGE_ME_RANDOM_SECRET_AT_LEAST_32_CHARS
XVM_DATA_DIR=/var/lib/xianyu-monitor

# Admin UI (bind to localhost/LAN only; put TLS in front if exposed beyond the LAN)
XVM_WEB_HOST=127.0.0.1
XVM_WEB_PORT=8080
XVM_WEB_BASE_URL=
XVM_SESSION_COOKIE_SECURE=false
XVM_DEFAULT_LANGUAGE=en

# SMTP (sender account is yours to choose; use an app password where supported)
XVM_SMTP_HOST=smtp.example.com
XVM_SMTP_PORT=587
XVM_SMTP_SECURITY=starttls
XVM_SMTP_USERNAME=monitor@example.com
XVM_SMTP_PASSWORD=CHANGE_ME_SMTP_PASSWORD
XVM_SMTP_FROM=monitor@example.com
XVM_SMTP_TIMEOUT_SECONDS=30
# New-customer notification recipient(s), comma separated
XVM_NOTIFY_TO=owner@example.com

# Capture of the EXISTING desktop (no new browser/desktop session is started)
XVM_CAPTURE_BACKEND=scrot
# "auto" discovers a single Xvnc session; set e.g. :10 if several exist
XVM_CAPTURE_DISPLAY=auto
XVM_CAPTURE_XAUTHORITY=auto

# OCR: rapidocr (default, ONNX Runtime CPU) or tesseract
XVM_OCR_BACKEND=rapidocr
XVM_OCR_WORKERS=1
# Pin OCR processes to the fastest cores (RK3588: the four Cortex-A76). auto | none | 4-7
XVM_OCR_CPU_AFFINITY=auto
# ONNX Runtime threads per OCR process; 0 = one per pinned core
XVM_OCR_THREADS=0
# Exact-pixel OCR result cache entries (identical crops are not re-read); 0 disables
XVM_OCR_CACHE_SIZE=4096
XVM_TESSERACT_LANG=chi_sim+eng

# Reply input (used only after the owner enables reply sending in the admin UI)
XVM_INPUT_BACKEND=xdotool
XVM_INPUT_TEXT_METHOD=clipboard

XVM_WORKER_NAME=desktop-main
XVM_LOG_LEVEL=INFO
XVM_LOG_JSON=true
