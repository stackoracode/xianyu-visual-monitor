[Unit]
Description=Xianyu Visual Monitor - admin web UI
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=xvm
Group=xvm
EnvironmentFile=/etc/xianyu-monitor/monitor.env
WorkingDirectory=/opt/xianyu-monitor
# Several HTTP workers are safe: the web app never captures, OCRs or sends input.
ExecStart=/opt/xianyu-monitor/env/bin/xianyu-monitor web --workers 2
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/xianyu-monitor
UMask=0027

[Install]
WantedBy=multi-user.target
